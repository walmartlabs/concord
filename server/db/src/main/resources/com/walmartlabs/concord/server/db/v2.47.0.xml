<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="2470000" author="benjamin.broadaway@walmart.com">
        <createTable tableName="EXTERNAL_IDENTITIES">
            <column name="PROVIDER_ID" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="AUTHORITY" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="SUBJECT_ID" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="uuid">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="UK_EXTERNAL_IDENTITIES_USER_ID"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="EXTERNAL_IDENTITIES"
                       columnNames="PROVIDER_ID, AUTHORITY, SUBJECT_ID"
                       constraintName="PK_EXTERNAL_IDENTITIES"/>
        <addForeignKeyConstraint baseTableName="EXTERNAL_IDENTITIES"
                                 baseColumnNames="USER_ID"
                                 constraintName="FK_EXTERNAL_IDENTITIES_USER_ID"
                                 referencedTableName="USERS"
                                 referencedColumnNames="USER_ID"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="2470010" author="benjamin.broadaway@walmart.com">
        <addColumn tableName="EXTERNAL_APP_USERS">
            <column name="IS_AUTHORITATIVE" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="2470020" author="benjamin.broadaway@walmart.com">
        <addColumn tableName="EXTERNAL_IDENTITIES">
            <column name="REFRESH_GENERATION" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="APPLIED_GENERATION" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="SOURCE_STATUS" type="varchar(32)"/>
            <column name="LAST_SUCCESSFUL_SYNC" type="timestamp with time zone"/>
        </addColumn>
    </changeSet>

    <changeSet id="2470030" author="benjamin.broadaway@walmart.com">
        <createView viewName="V_USER_ROLES" replaceIfExists="true">
            select USER_ID, ROLE_ID
            from USER_ROLES
            union
            select distinct ulg.USER_ID, rlg.ROLE_ID
            from ROLE_LDAP_GROUPS rlg
            join USER_LDAP_GROUPS ulg on ulg.LDAP_GROUP = rlg.LDAP_GROUP
            join USERS u on u.USER_ID = ulg.USER_ID
            where u.USER_TYPE != 'EXTERNAL'
            and not exists(select 1 from USER_ROLES ur where ur.USER_ID = ulg.USER_ID and ur.ROLE_ID = rlg.ROLE_ID)
        </createView>
    </changeSet>

    <changeSet id="2470040" author="benjamin.broadaway@walmart.com">
        <addColumn tableName="PROCESS_QUEUE">
            <column name="EXTERNAL_IDENTITY_SCOPE" type="jsonb"
                    remarks="Server-owned immutable delegation binding, never restored from process state"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
